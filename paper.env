# Paths for reproducing the Tracktail paper. Edit the defaults or preset any variable, then:
#   source paper.env
# Values already set in the environment win. Every paper driver sources this file.
_PAPER_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# Site-local overrides (not tracked), e.g. a cluster's data paths; read first so the defaults below build on them
[ -f "$_PAPER_ENV_DIR/paper.local.env" ] && . "$_PAPER_ENV_DIR/paper.local.env"

# Datasets: <TRACKTAIL_DATA>/<dataset>/{train,val,test}/<session>/<trial>/{metadata.yaml,img|vid,pose3d*.npz}
# (kubric-multiview, point-odyssey-human, po-animal-sub256-motion, dex_ycb, cmupanoptic_3dgs, tapvid3d_*)
export TRACKTAIL_DATA="${TRACKTAIL_DATA:-$_PAPER_ENV_DIR/data}"
# MVTracker's own benchmark datasets (kubric-multiview/test, dex-ycb-multiview, panoptic-multiview, with
# their cachedtracks files): source of pose3d_cached.npz, GT depths and the DUSt3R depth precompute
export MVTRACKER_DATA="${MVTRACKER_DATA:-$_PAPER_ENV_DIR/data/mvtracker}"
# All outputs (training runs, predictions, metrics, logs)
export TRACKTAIL_RESULTS="${TRACKTAIL_RESULTS:-$_PAPER_ENV_DIR/results}"
# Your own trained models, one per paper network name (scripts/paper_common.sh): $TRACKTAIL_MODELS/<network>/model.pth
# (scripts/package_checkpoint.py) or $TRACKTAIL_MODELS/<network> -> a W&B run dir. Only the paper model is on HF.
# Drivers look in this order: $TRACKTAIL_WANDB_BASE (if set), $TRACKTAIL_MODELS/<network>, HF (paper model only).
export TRACKTAIL_MODELS="${TRACKTAIL_MODELS:-$TRACKTAIL_RESULTS/models}"
# Finetuning (configs/paper/finetune.toml) starts from your pretrain checkpoint:
# export PRETRAIN_CKPT=$TRACKTAIL_RESULTS/training/wandb/run-<date>-<id>/files/checkpoints/checkpoint_00799996.pth
# External baseline repos + weights (baselines/setup.sh)
export BASELINE_ROOT="${BASELINE_ROOT:-$_PAPER_ENV_DIR/external}"
export TRACKTAIL_LOGS="${TRACKTAIL_LOGS:-$TRACKTAIL_RESULTS/logs}"

# The paper model on Hugging Face (W&B run vzkjqrys, checkpoint 2314240)
export TRACKTAIL_HF_REPO="${TRACKTAIL_HF_REPO:-ai-hhmi/tracktail-static}"
export TRACKTAIL_HF_REVISION="${TRACKTAIL_HF_REVISION:-2026-10-12}"
# Optional: a folder with the original W&B run dirs (run-<date>-<id>/files/{config.toml,checkpoints}) of the paper.
# When set, the Tracktail drivers load those for every network, including the paper model. Unset by default.
# export TRACKTAIL_WANDB_BASE=/path/to/posetail-pretraining-v6/wandb

# Baselines (layout written by baselines/setup.sh; see baselines/README.md)
export MVTRACKER_REPO="${MVTRACKER_REPO:-$BASELINE_ROOT/mvtracker}"
export MVT_HUB_DIR="${MVT_HUB_DIR:-$MVTRACKER_REPO}"        # torch.hub local source = the pinned clone
export DUST3R_REPO="${DUST3R_REPO:-$BASELINE_ROOT/dust3r}"
export COTRACKER_REPO="${COTRACKER_REPO:-$BASELINE_ROOT/co-tracker}"
export ARROW_REPO="${ARROW_REPO:-$BASELINE_ROOT/arrow}"
export MVTRACKER_CKPT="${MVTRACKER_CKPT:-$BASELINE_ROOT/weights/mvtracker_200000_june2025.pth}"
export DUST3R_CKPT="${DUST3R_CKPT:-$BASELINE_ROOT/weights/DUSt3R_ViTLarge_BaseDecoder_512_dpt.pth}"
export COTRACKER_CKPT="${COTRACKER_CKPT:-$BASELINE_ROOT/weights/scaled_offline.pth}"
export ARROW_CKPT="${ARROW_CKPT:-$BASELINE_ROOT/weights/arrow}"
# Python interpreters of the baseline environments (MVTracker + DUSt3R share one; ARROW uses its own uv venv)
export MVTRACKER_PYTHON="${MVTRACKER_PYTHON:-python}"
export DUST3R_PYTHON="${DUST3R_PYTHON:-$MVTRACKER_PYTHON}"
export ARROW_PYTHON="${ARROW_PYTHON:-$ARROW_REPO/.venv/bin/python}"

unset _PAPER_ENV_DIR
